<%- include('partials/head', { title: 'A reply to your question', preheader: 'Someone replied to your question on Maison.' }) %>

<p style="margin:0; font-family:Helvetica,Arial,sans-serif; font-size:10px; font-weight:bold; letter-spacing:3px; text-transform:uppercase; color:#A07C4B;">
  New Reply
</p>

<h1 style="margin:14px 0 0 0; font-family:Georgia,'Times New Roman',serif; font-size:34px; font-weight:500; line-height:1.15; color:#1A1816;">
  You have a reply
</h1>

<p style="margin:24px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:15px; line-height:1.75; color:#4A453F;">
  Hello <%= name %>,
</p>

<p style="margin:14px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:15px; line-height:1.75; color:#4A453F;">
  Someone has replied to your question on:
</p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:22px 0 0 0;">
  <tr>
    <td style="background-color:#F7F4EF; border-left:2px solid #A07C4B; padding:20px 22px;">
      <p style="margin:0; font-family:Georgia,'Times New Roman',serif; font-size:20px; font-weight:500; line-height:1.4; color:#1A1816;">
        <%= title %>
      </p>
    </td>
  </tr>
</table>

<p style="margin:26px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:15px; line-height:1.75; color:#4A453F;">
  Visit your dashboard to read the full reply and continue the conversation.
</p>

<p style="margin:28px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:13px; line-height:1.7; color:#8A8278;">
  If you have any further questions, simply reply to this email.
</p>

<%- include('partials/foot') %>
