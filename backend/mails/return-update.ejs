<%- include('partials/head', { title: copy.headline, preheader: copy.preheader }) %>

<p style="margin:0; font-family:Helvetica,Arial,sans-serif; font-size:10px; font-weight:bold; letter-spacing:3px; text-transform:uppercase; color:<%= kind === 'declined' ? '#B4533F' : '#A07C4B' %>;">
  <%= copy.eyebrow %>
</p>

<h1 style="margin:14px 0 0 0; font-family:Georgia,'Times New Roman',serif; font-size:32px; font-weight:500; line-height:1.15; color:#1A1816;">
  <%= copy.headline %><%= user && user.name ? ', ' + user.name.split(' ')[0] : '' %>
</h1>

<% copy.paragraphs.forEach(function (p) { %>
<p style="margin:18px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:15px; line-height:1.75; color:#4A453F;"><%= p %></p>
<% }); %>

<% if (copy.steps && copy.steps.length) { %>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:24px 0 0 0;">
  <tr>
    <td style="background-color:#F7F4EF; border:1px solid #E0D9CE; padding:20px 22px;">
      <p style="margin:0; font-family:Helvetica,Arial,sans-serif; font-size:10px; letter-spacing:2px; text-transform:uppercase; color:#8A8278;">What to do next</p>
      <% copy.steps.forEach(function (step, i) { %>
      <p style="margin:<%= i === 0 ? '10px' : '8px' %> 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:14px; line-height:1.6; color:#1A1816;"><%= i + 1 %>. <%= step %></p>
      <% }); %>
    </td>
  </tr>
</table>
<% } %>

<!-- Return summary -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:24px 0 0 0;">
  <tr>
    <td style="border:1px solid #E0D9CE; padding:18px 22px;">
      <p style="margin:0; font-family:Helvetica,Arial,sans-serif; font-size:10px; letter-spacing:2px; text-transform:uppercase; color:#8A8278;">Order</p>
      <p style="margin:5px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:14px; color:#1A1816; word-break:break-all;"><%= order._id %></p>
      <% if (reason) { %>
      <p style="margin:14px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:10px; letter-spacing:2px; text-transform:uppercase; color:#8A8278;">Reason</p>
      <p style="margin:5px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:14px; color:#1A1816;"><%= reason %></p>
      <% } %>
      <% if (details) { %>
      <p style="margin:4px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:13px; font-style:italic; color:#4A453F;">&ldquo;<%= details %>&rdquo;</p>
      <% } %>
      <% if (kind !== 'declined') { %>
      <p style="margin:14px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:10px; letter-spacing:2px; text-transform:uppercase; color:#8A8278;"><%= kind === 'approved' ? 'Your refund' : 'Refund once approved' %></p>
      <p style="margin:5px 0 0 0; font-family:Georgia,'Times New Roman',serif; font-size:20px; color:#A07C4B;"><%= refundAmount %></p>
      <% } %>
    </td>
  </tr>
</table>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:26px 0 0 0;">
  <tr>
    <td align="left">
      <a href="<%= orderLink %>"
         style="display:inline-block; padding:14px 30px; background-color:#1A1816; color:#F7F4EF; font-family:Helvetica,Arial,sans-serif; font-size:11px; font-weight:bold; letter-spacing:2px; text-transform:uppercase; text-decoration:none;">
        Follow your return
      </a>
    </td>
  </tr>
</table>

<%- include('partials/foot') %>
