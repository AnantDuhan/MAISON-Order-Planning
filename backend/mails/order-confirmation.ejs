<%- include('partials/head', { title: 'Your order', preheader: 'Thank you — your Maison order is confirmed.' }) %>

<p style="margin:0; font-family:Helvetica,Arial,sans-serif; font-size:10px; font-weight:bold; letter-spacing:3px; text-transform:uppercase; color:#A07C4B;">
  Order <%= status %>
</p>

<h1 style="margin:14px 0 0 0; font-family:Georgia,'Times New Roman',serif; font-size:34px; font-weight:500; line-height:1.15; color:#1A1816;">
  Thank you, <%= user.name %>
</h1>

<p style="margin:22px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:15px; line-height:1.75; color:#4A453F;">
  Your order has been <%= status %> and is being prepared with care.
</p>

<!-- Meta -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:28px 0 0 0;">
  <tr>
    <td style="background-color:#F7F4EF; border:1px solid #E0D9CE; padding:20px 22px;">
      <p style="margin:0; font-family:Helvetica,Arial,sans-serif; font-size:10px; letter-spacing:2px; text-transform:uppercase; color:#8A8278;">Order Reference</p>
      <p style="margin:5px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:14px; color:#1A1816; word-break:break-all;"><%= order._id %></p>

      <p style="margin:16px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:10px; letter-spacing:2px; text-transform:uppercase; color:#8A8278;">Estimated Delivery</p>
      <p style="margin:5px 0 0 0; font-family:Georgia,'Times New Roman',serif; font-size:19px; color:#A07C4B;"><%= estimatedDeliveryDate %></p>
    </td>
  </tr>
</table>

<!-- Items -->
<p style="margin:32px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:10px; font-weight:bold; letter-spacing:3px; text-transform:uppercase; color:#A07C4B;">
  Your Items
</p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:14px 0 0 0;">
  <% order.orderItems.forEach(item => { %>
    <% const imageUrl = item.images && item.images[0] && item.images[0].url ? item.images[0].url : (item.image || null); %>
    <tr>
      <td style="padding:16px 0; border-bottom:1px solid #E0D9CE;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
          <tr>
            <% if (imageUrl) { %>
              <td width="72" valign="top" style="width:72px; padding-right:16px;">
                <img src="<%= imageUrl %>" alt="<%= item.name %>" width="72"
                     style="display:block; width:72px; height:88px; object-fit:cover; border:1px solid #E0D9CE;" />
              </td>
            <% } %>
            <td valign="middle">
              <p style="margin:0; font-family:Georgia,'Times New Roman',serif; font-size:18px; font-weight:500; color:#1A1816;">
                <%= item.name %>
              </p>
              <p style="margin:6px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:13px; color:#8A8278;">
                Qty <%= item.quantity %> &nbsp;·&nbsp; &#8377;<%= item.price %>
              </p>
            </td>
            <td valign="middle" align="right" style="white-space:nowrap;">
              <p style="margin:0; font-family:Helvetica,Arial,sans-serif; font-size:15px; color:#1A1816;">
                &#8377;<%= item.price * item.quantity %>
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  <% }); %>
</table>

<!-- Total -->
<% if (order.totalPrice !== undefined) { %>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:18px 0 0 0;">
  <tr>
    <td align="left" style="padding-top:6px;">
      <p style="margin:0; font-family:Helvetica,Arial,sans-serif; font-size:11px; letter-spacing:3px; text-transform:uppercase; color:#1A1816;">Total</p>
    </td>
    <td align="right" style="padding-top:6px;">
      <p style="margin:0; font-family:Georgia,'Times New Roman',serif; font-size:26px; font-weight:500; color:#1A1816;">
        &#8377;<%= order.totalPrice %>
      </p>
    </td>
  </tr>
</table>
<% } %>

<p style="margin:30px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:13px; line-height:1.7; color:#8A8278;">
  We'll be in touch as soon as your parcel is on its way.
</p>

<%- include('partials/foot') %>
