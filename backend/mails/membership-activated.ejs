<%- include('partials/head', { title: 'Membership active', preheader: 'Your Maison membership is now active.' }) %>

<p style="margin:0; font-family:Helvetica,Arial,sans-serif; font-size:10px; font-weight:bold; letter-spacing:3px; text-transform:uppercase; color:#A07C4B;">
  Membership active
</p>

<h1 style="margin:14px 0 0 0; font-family:Georgia,'Times New Roman',serif; font-size:34px; font-weight:500; line-height:1.15; color:#1A1816;">
  Welcome, <%= user.name %>
</h1>

<p style="margin:22px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:15px; line-height:1.75; color:#4A453F;">
  Your Maison membership is now active. Your member benefits are ready to use.
</p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:28px 0 0 0;">
  <tr>
    <td style="background-color:#F7F4EF; border:1px solid #E0D9CE; padding:20px 22px;">
      <p style="margin:0; font-family:Helvetica,Arial,sans-serif; font-size:10px; letter-spacing:2px; text-transform:uppercase; color:#8A8278;">Membership</p>
      <p style="margin:5px 0 0 0; font-family:Georgia,'Times New Roman',serif; font-size:22px; color:#1A1816;"><%= membership.name %></p>

      <p style="margin:18px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:10px; letter-spacing:2px; text-transform:uppercase; color:#8A8278;">Next payment date</p>
      <p style="margin:5px 0 0 0; font-family:Georgia,'Times New Roman',serif; font-size:19px; color:#A07C4B;"><%= nextPaymentDate %></p>
    </td>
  </tr>
</table>

<p style="margin:30px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:13px; line-height:1.7; color:#8A8278;">
  Enjoy complimentary shipping, early access to new drops, and member-only offers.
</p>

<%- include('partials/foot') %>
