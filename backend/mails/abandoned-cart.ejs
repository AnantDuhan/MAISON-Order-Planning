<%- include('partials/head', { title: 'Your bag', preheader: stage === 1 ? 'Your selection is saved — pick up where you left off.' : 'A last reminder about the pieces in your bag.' }) %>

<p style="margin:0; font-family:Helvetica,Arial,sans-serif; font-size:10px; font-weight:bold; letter-spacing:3px; text-transform:uppercase; color:#A07C4B;">Your bag</p>
<h1 style="margin:14px 0 0 0; font-family:Georgia,'Times New Roman',serif; font-size:32px; font-weight:500; line-height:1.2; color:#1A1816;">
  <%= stage === 1 ? 'You left something behind' : 'Still thinking it over?' %>
</h1>
<p style="margin:20px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:15px; line-height:1.75; color:#4A453F;">
  <%= user.name ? user.name.split(' ')[0] + ', y' : 'Y' %>our selection is saved. Prices below are today's.
  <% if (items.some(function (i) { return i.lowStock; })) { %> Some pieces are nearly gone.<% } %>
</p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:26px 0 0 0; border-top:1px solid #E0D9CE;">
  <% items.forEach(function (item) { %>
  <tr>
    <td width="76" style="padding:16px 0; border-bottom:1px solid #E0D9CE;">
      <% if (item.image) { %><img src="<%= item.image %>" alt="<%= item.name %>" width="64" style="display:block; width:64px; border:1px solid #E0D9CE;" /><% } %>
    </td>
    <td style="padding:16px 12px; border-bottom:1px solid #E0D9CE; font-family:Helvetica,Arial,sans-serif; font-size:14px; color:#1A1816;">
      <%= item.name %>
      <div style="font-size:12px; color:<%= item.inStock ? (item.lowStock ? '#A07C4B' : '#8A8278') : '#B3261E' %>; margin-top:4px;">
        Qty <%= item.quantity %><%= !item.inStock ? ' · sold out' : item.lowStock ? ' · only a few left' : '' %>
      </div>
    </td>
    <td align="right" style="padding:16px 0; border-bottom:1px solid #E0D9CE; font-family:Georgia,'Times New Roman',serif; font-size:16px; color:#1A1816;">&#8377;<%= item.price * item.quantity %></td>
  </tr>
  <% }) %>
</table>

<p style="margin:26px 0 0 0;">
  <a href="<%= restoreLink %>" style="display:inline-block; background-color:#1A1816; color:#F7F4EF; padding:14px 26px; font-family:Helvetica,Arial,sans-serif; font-size:11px; letter-spacing:2px; text-transform:uppercase; text-decoration:none;">Return to your bag &middot; &#8377;<%= total %></a>
</p>

<p style="margin:30px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:11px; line-height:1.7; color:#8A8278;">
  <%= stage === 1 ? 'We’ll send at most one more reminder.' : 'This is the last reminder about this bag.' %>
  <a href="<%= unsubscribeLink %>" style="color:#8A8278;">Stop bag reminders</a>
</p>

<%- include('partials/foot') %>
