<%- include('partials/head', { title: 'How is it?', preheader: 'A few honest words help other shoppers choose.' }) %>

<p style="margin:0; font-family:Helvetica,Arial,sans-serif; font-size:10px; font-weight:bold; letter-spacing:3px; text-transform:uppercase; color:#A07C4B;">A note from the house</p>
<h1 style="margin:14px 0 0 0; font-family:Georgia,'Times New Roman',serif; font-size:30px; font-weight:500; line-height:1.25; color:#1A1816;">
  Hello <%= firstName %>, how is it?
</h1>
<p style="margin:16px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:15px; line-height:1.75; color:#4A453F;">
  Your order arrived<% if (deliveredOn) { %> on <%= deliveredOn %><% } %>. Once you've lived with it a little, would you tell other shoppers what you think?
  A few honest words, good or bad, help them choose, and help us choose what to keep in the shop.
</p>

<% items.forEach(function (item) { %>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-top:24px; border-top:1px solid #E0D9CE;">
  <tr>
    <% if (item.photo) { %>
    <td width="96" valign="top" style="padding:20px 18px 0 0;">
      <a href="<%= item.link %>"><img src="<%= item.photo %>" alt="" width="96" style="display:block; width:96px; height:auto; border:1px solid #E0D9CE;" /></a>
    </td>
    <% } %>
    <td valign="top" style="padding:20px 0 0 0;">
      <p style="margin:0; font-family:Georgia,'Times New Roman',serif; font-size:20px; line-height:1.3; color:#1A1816;"><%= item.name %></p>
      <p style="margin:10px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:12px; color:#8A8278;">Tap a star to start your review:</p>
      <p style="margin:4px 0 0 0; font-size:28px; line-height:1; letter-spacing:4px;">
        <% [1, 2, 3, 4, 5].forEach(function (n) { %><a href="<%= item.link %>&amp;rating=<%= n %>" title="<%= n %> of 5" style="color:#A07C4B; text-decoration:none;">&#9733;</a><% }) %>
      </p>
      <p style="margin:14px 0 0 0;">
        <a href="<%= item.link %>" style="display:inline-block; background-color:#1A1816; color:#F7F4EF; padding:12px 22px; font-family:Helvetica,Arial,sans-serif; font-size:11px; letter-spacing:2px; text-transform:uppercase; text-decoration:none;">Write a review</a>
      </p>
    </td>
  </tr>
</table>
<% }) %>

<p style="margin:30px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:12px; line-height:1.7; color:#8A8278;">
  We ask once per order. Reviews on Maison come only from customers whose order has been delivered.
  <a href="<%= unsubscribeLink %>" style="color:#8A8278;">Don't ask me for reviews</a>
</p>

<%- include('partials/foot') %>
