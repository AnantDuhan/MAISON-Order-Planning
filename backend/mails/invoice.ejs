<%- include('partials/head', { title: 'Your invoice', preheader: 'Invoice ' + invoice.invoiceNumber + ' from MAISON.' }) %>

<p style="margin:0; font-family:Helvetica,Arial,sans-serif; font-size:10px; font-weight:bold; letter-spacing:3px; text-transform:uppercase; color:#A07C4B;">
  <%= invoice.type === 'membership' ? 'Membership invoice' : 'Invoice' %>
</p>

<h1 style="margin:14px 0 0 0; font-family:Georgia,'Times New Roman',serif; font-size:34px; font-weight:500; line-height:1.15; color:#1A1816;">
  Thank you<%= invoice.billedTo && invoice.billedTo.name ? ', ' + invoice.billedTo.name : '' %>
</h1>

<p style="margin:22px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:15px; line-height:1.75; color:#4A453F;">
  Your invoice is attached to this email as a PDF. You can also download it any time from your account.
</p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:28px 0 0 0;">
  <tr>
    <td style="background-color:#F7F4EF; border:1px solid #E0D9CE; padding:20px 22px;">
      <p style="margin:0; font-family:Helvetica,Arial,sans-serif; font-size:10px; letter-spacing:2px; text-transform:uppercase; color:#8A8278;">Invoice number</p>
      <p style="margin:5px 0 0 0; font-family:Georgia,'Times New Roman',serif; font-size:22px; color:#1A1816;"><%= invoice.invoiceNumber %></p>

      <p style="margin:18px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:10px; letter-spacing:2px; text-transform:uppercase; color:#8A8278;">Amount paid</p>
      <p style="margin:5px 0 0 0; font-family:Georgia,'Times New Roman',serif; font-size:19px; color:#A07C4B;">&#8377;<%= Number(invoice.total).toFixed(2) %></p>
    </td>
  </tr>
</table>

<%- include('partials/foot') %>
