# Copy to backend/config/config.env and fill in. config.env is git-ignored.

# --- Runtime ---
PORT=8080
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
RESULT_PER_PAGE=8

# --- Database ---
DB_HOSTED_URI=

# --- Auth ---
JWT_SECRET_KEY=
JWT_EXPIRES_IN=90d
GOOGLE_CLIENT_ID=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Payments (Cashfree) ---
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_WEBHOOK_URL=
CASHFREE_RETURN_URL=
CASHFREE_MONTHLY_AMOUNT=299
CASHFREE_YEARLY_AMOUNT=1599

# --- Redis ---
# REST client used for caching when REDIS_URL is not set
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# TCP URL for rate limiting, BullMQ and the Socket.io adapter
REDIS_UPSTASH_URL=
# Optional: plain Redis for caching (e.g. docker-compose)
REDIS_URL=

# --- Search / AI ---
ELASTICSEARCH_NODE=
ELASTICSEARCH_API_KEY=
GEMINI_API_KEY=

# --- Storage (S3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_BUCKET_REGION=

# --- Scheduled jobs ---
CRON_SECRET=
