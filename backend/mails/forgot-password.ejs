<%- include('partials/head', { title: 'Reset your password', preheader: 'A link to reset your Maison password — valid for a short time.' }) %>

<p style="margin:0; font-family:Helvetica,Arial,sans-serif; font-size:10px; font-weight:bold; letter-spacing:3px; text-transform:uppercase; color:#A07C4B;">
  Account Security
</p>

<h1 style="margin:14px 0 0 0; font-family:Georgia,'Times New Roman',serif; font-size:34px; font-weight:500; line-height:1.15; color:#1A1816;">
  Reset your password
</h1>

<p style="margin:24px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:15px; line-height:1.75; color:#4A453F;">
  Hello <%= name %>,
</p>

<p style="margin:14px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:15px; line-height:1.75; color:#4A453F;">
  We received a request to reset the password on your Maison account. Use the
  button below to choose a new one.
</p>

<!-- Button -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:32px 0 0 0;">
  <tr>
    <td align="center" bgcolor="#1A1816" style="background-color:#1A1816;">
      <a href="<%= activationCode %>"
         style="display:inline-block; padding:16px 34px; font-family:Helvetica,Arial,sans-serif; font-size:11px; font-weight:bold; letter-spacing:3px; text-transform:uppercase; color:#F7F4EF; text-decoration:none;">
        Reset Password
      </a>
    </td>
  </tr>
</table>

<p style="margin:28px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:12px; line-height:1.7; color:#8A8278;">
  If the button doesn't work, copy this link into your browser:
</p>
<p style="margin:6px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:12px; line-height:1.7; word-break:break-all;">
  <a href="<%= activationCode %>" style="color:#A07C4B; text-decoration:none;"><%= activationCode %></a>
</p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:32px 0 0 0;">
  <tr><td style="border-top:1px solid #E0D9CE; font-size:0; line-height:0;">&nbsp;</td></tr>
</table>

<p style="margin:20px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:13px; line-height:1.7; color:#8A8278;">
  Didn't request this? You can safely ignore this email — your password will
  stay as it is.
</p>

<%- include('partials/foot') %>
